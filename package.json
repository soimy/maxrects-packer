{
  "name": "maxrects-packer",
  "version": "2.7.4",
  "description": "A max rectangle 2d bin packer for packing glyphs or images into multiple sprite-sheet/atlas",
  "type": "module",
  "main": "dist/maxrects-packer.cjs",
  "module": "dist/maxrects-packer.mjs",
  "types": "dist/maxrects-packer.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "assets/favicon32.png",
    "assets/preview.png"
  ],
  "scripts": {
    "clean": "rimraf ./dist ./lib",
    "build": "rollup -c",
    "postbuild": "node scripts/verify-entry.mjs",
    "build:clean": "npm run clean && npm run build",
    "doc": "typedoc && touch docs/.nojekyll && cp assets/favicon.ico docs/ && cp assets/favicon.png docs/assets/",
    "doc:clean": "rimraf docs && mkdir docs",
    "doc:json": "typedoc --json docs/typedoc.json",
    "doc:publish": "gh-pages --nojekyll -m \"[ci skip] Updates\" -d docs",
    "doc:serve": "cd docs && npx http-server",
    "test": "npm run build:clean && jest",
    "cover": "npm run build:clean && jest --coverage",
    "typecheck": "node scripts/typecheck.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "lint": "oxlint src test scripts",
    "lint:fix": "oxlint --fix src test scripts",
    "format": "oxfmt \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.mjs\" \"*.js\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.mjs\" \"*.js\"",
    "version": "commit-and-tag-version",
    "prepare-release": "npm run test && npm run version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://soimy@github.com/soimy/maxrects-packer.git"
  },
  "keywords": [
    "spritesheet",
    "atlas",
    "bin",
    "pack",
    "max",
    "rect"
  ],
  "author": "YM Shen <soimy@163.com> (http://github.com/soimy)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/soimy/maxrects-packer/issues"
  },
  "homepage": "https://github.com/soimy/maxrects-packer#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "ascii-table": "^0.0.9",
    "commit-and-tag-version": "^13.2.1",
    "cz-conventional-changelog": "^3.3.0",
    "gh-pages": "^6.3.0",
    "jest": "^30.5.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.4",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typedoc-unhoax-theme": "^0.5.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
