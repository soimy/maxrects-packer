{
  "name": "maxrects-packer",
  "version": "2.7.4",
  "description": "A max rectangle 2d bin packer for packing glyphs or images into multiple sprite-sheet/atlas",
  "type": "module",
  "main": "dist/maxrects-packer.cjs",
  "module": "dist/maxrects-packer.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "assets/favicon.ico",
    "CHANGELOG.md",
    "tsconfig.json",
    "tsconfig.build.json",
    "typedoc.json"
  ],
  "scripts": {
    "clean": "rimraf ./dist ./lib",
    "build": "rollup -c",
    "postbuild": "node scripts/fix-declaration-extensions.mjs && node scripts/verify-entry.mjs && node scripts/verify-es5.mjs",
    "build:clean": "npm run clean && npm run build",
    "docs:api": "rimraf docs/api && typedoc",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs && node scripts/build-legacy-redirects.mjs && node scripts/verify-docs-output.mjs",
    "docs:preview": "vitepress preview docs",
    "docs:clean": "rimraf docs/api docs/.vitepress/cache docs/.vitepress/dist",
    "doc": "npm run docs:build",
    "doc:clean": "npm run docs:clean",
    "doc:json": "typedoc --json docs/api/typedoc.json",
    "doc:serve": "npm run docs:preview",
    "test": "npm run build:clean && vitest run",
    "cover": "npm run build:clean && rimraf test/coverage && vitest run --coverage && node scripts/verify-coverage.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "lint": "oxlint src test scripts docs/.vitepress",
    "lint:fix": "oxlint --fix src test scripts docs/.vitepress",
    "format": "oxfmt \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.mjs\" \"*.js\" \"docs/.vitepress/*.mts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.mjs\" \"*.js\" \"docs/.vitepress/*.mts\"",
    "version": "commit-and-tag-version",
    "prepare-release": "npm run test && npm run version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://soimy@github.com/soimy/maxrects-packer.git"
  },
  "keywords": [
    "spritesheet",
    "atlas",
    "bin",
    "pack",
    "max",
    "rect"
  ],
  "author": "YM Shen <soimy@163.com> (http://github.com/soimy)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/soimy/maxrects-packer/issues"
  },
  "homepage": "https://github.com/soimy/maxrects-packer#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "ascii-table": "^0.0.9",
    "commit-and-tag-version": "^13.2.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.4",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
