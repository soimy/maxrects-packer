{
  "entryPoints": ["src/index.ts"],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "docsRoot": "docs",
  "readme": "none",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "theme": "default",
  "excludeExternals": true,
  "excludeNotDocumented": false,
  "excludePrivate": true,
  "skipErrorChecking": true,
  "tsconfig": "tsconfig.json"
}